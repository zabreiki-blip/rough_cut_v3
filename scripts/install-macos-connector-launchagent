#!/usr/bin/env bash
# Installs macOS connector as a LaunchAgent (auto-start on login)
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLIST_NAME="com.roughcut.macos-connector"
PLIST_DST="${HOME}/Library/LaunchAgents/${PLIST_NAME}.plist"
LOG_DIR="${HOME}/Library/Logs/RoughCut"
CONNECTOR_ENV="${HOME}/Library/Application Support/RoughCut/macos-connector.env"
VENV_DIR="${ROUGH_CUT_VENV:-${ROOT_DIR}/.venv}"
PYTHON_BIN="${VENV_DIR}/bin/python3"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="$(command -v python3)"
fi

mkdir -p "${LOG_DIR}"
mkdir -p "$(dirname "${CONNECTOR_ENV}")"

# Keep only connector-specific settings in a separate mode-600 file. Never copy
# cloud API keys or the complete project .env into a world-readable plist.
: > "${CONNECTOR_ENV}"
if [[ -f "${ROOT_DIR}/.env" ]]; then
  while IFS= read -r line; do
    case "${line}" in
      MACOS_CONNECTOR_TOKEN=*|MACOS_CONNECTOR_BIND=*|MACOS_CONNECTOR_PORT=*|MACOS_TTS_*=*)
        printf '%s\n' "${line}" >> "${CONNECTOR_ENV}"
        ;;
    esac
  done < "${ROOT_DIR}/.env"
fi
chmod 600 "${CONNECTOR_ENV}"

cat > "${PLIST_DST}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${PLIST_NAME}</string>

  <key>ProgramArguments</key>
  <array>
    <string>${PYTHON_BIN}</string>
    <string>-m</string>
    <string>macos_connector</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>${ROOT_DIR}/src</string>
    <key>MACOS_CONNECTOR_ENV_FILE</key>
    <string>${CONNECTOR_ENV}</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>${HOME}/Library/Application Support/RoughCut</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>${LOG_DIR}/macos-connector.log</string>

  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/macos-connector.error.log</string>
</dict>
</plist>
PLIST

# Unload if already loaded (ignore errors)
launchctl unload "${PLIST_DST}" 2>/dev/null || true

# Load
launchctl load "${PLIST_DST}"

echo "✓ LaunchAgent установлен: ${PLIST_DST}"
echo "✓ Коннектор запущен на порту 8001"
echo ""
echo "Управление:"
echo "  Остановить:    launchctl unload ${PLIST_DST}"
echo "  Запустить:     launchctl load   ${PLIST_DST}"
echo "  Статус:        curl http://localhost:8001/health"
echo "  Удалить:       rm ${PLIST_DST}"
echo "  Логи:          tail -f ${LOG_DIR}/macos-connector.log"
