#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Этот bootstrap предназначен для macOS." >&2
  exit 2
fi

"${ROOT_DIR}/scripts/setup-local"
"${ROOT_DIR}/scripts/install-macos-connector-launchagent"
"${ROOT_DIR}/scripts/install-cep-macos"
"${ROOT_DIR}/scripts/doctor"
echo "macOS bootstrap завершён. Перезапустите Premiere Pro."
