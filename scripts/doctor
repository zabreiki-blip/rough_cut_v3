#!/usr/bin/env bash
set -u
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${ROOT_DIR}/scripts/lib/local-profile.sh"
select_local_profile || exit 2
QUICK=0
[[ "${1:-}" == "--quick" ]] && QUICK=1
ERRORS=0
WARNINGS=0
ok() { echo "✅ $*"; }
warn() { echo "⚠️  $*"; WARNINGS=$((WARNINGS + 1)); }
fail() { echo "❌ $*"; ERRORS=$((ERRORS + 1)); }
echo "Диагностика rough_cut_v3: ${ROUGH_CUT_PROFILE}, ${VENV_DIR}"
if [[ -x "${VENV_DIR}/bin/python" ]]; then
  if validate_local_python "${VENV_DIR}/bin/python"; then
    ok "Python: $("${VENV_DIR}/bin/python" --version 2>&1)"
  else
    fail "Неподдерживаемый Python выбранного окружения"
  fi
else
  missing_local_environment
  fail "Нет ${VENV_DIR}; запустите scripts/setup-local"
fi
for command in ffmpeg ffprobe; do
  command -v "${command}" >/dev/null 2>&1 && ok "${command} найден" || fail "Нет ${command}: установите ffmpeg"
done
if command -v antiword >/dev/null 2>&1 || command -v catdoc >/dev/null 2>&1; then
  ok "Конвертер .doc найден"
else
  warn "Нет antiword/catdoc; только старые .doc требуют brew install catdoc"
fi
command -v node >/dev/null 2>&1 && ok "Node.js найден" || warn "Node.js не найден; CEP behavior test будет пропущен"
if [[ ! -f "${ROOT_DIR}/.env" ]]; then
  fail "Нет .env; запустите scripts/setup-local"
elif [[ -x "${VENV_DIR}/bin/python" ]]; then
  if ! PYTHONPATH="${ROOT_DIR}/src" "${VENV_DIR}/bin/python" "${ROOT_DIR}/scripts/lib/check-env.py" "${ROOT_DIR}/.env" "${LOCAL_OS}" "${QUICK}"; then
    fail "Исправьте настройки .env или локального TTS"
  fi
fi
if [[ -x "${VENV_DIR}/bin/python" ]]; then
  if [[ "${ROUGH_CUT_PROFILE}" == mlx ]]; then BACKEND=mlx_whisper; else BACKEND=faster_whisper; fi
  if "${VENV_DIR}/bin/python" -c "import ${BACKEND}" >/dev/null 2>&1; then
    ok "Локальный ASR: ${BACKEND} установлен"
  else
    fail "Нет ${BACKEND}; выполните scripts/setup-local с выбранным профилем"
  fi
fi
echo "Whisper: модель загружается при первом ASR, нужен интернет, ~1.5 GB для medium; cache: ${HF_HOME:-${ROOT_DIR}/.cache/huggingface}."
FREE_KB="$(df -Pk "${ROOT_DIR}" 2>/dev/null | awk 'NR==2 {print $4}')"
if [[ -n "${FREE_KB}" && "${FREE_KB}" -lt 2097152 ]]; then
  warn "Мало места: модели Whisper может потребоваться ~1.5 GB"
fi
if [[ "${QUICK}" -eq 0 ]]; then
  curl -fsS --max-time 3 http://127.0.0.1:8000/health >/dev/null 2>&1 && ok "Backend отвечает на :8000" || warn "Backend на :8000 не отвечает; запустите scripts/run-local"
fi
echo "Итог: ошибок ${ERRORS}, предупреждений ${WARNINGS}"
[[ "${ERRORS}" -eq 0 ]]
