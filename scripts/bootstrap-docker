#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  echo "Docker with Compose v2 is required." >&2
  exit 2
fi

if [[ ! -f .env ]]; then
  if ! command -v openssl >/dev/null 2>&1; then
    echo "OpenSSL is required to generate ROUGH_CUT_API_TOKEN." >&2
    exit 2
  fi
  cp .env.example .env
  GENERATED_TOKEN="$(openssl rand -hex 32)"
  TEMP_ENV="$(mktemp "${ROOT_DIR}/.env.XXXXXX")"
  trap 'rm -f "${TEMP_ENV}"' EXIT
  awk -v token="${GENERATED_TOKEN}" '
    /^ROUGH_CUT_API_TOKEN=/ {$0 = "ROUGH_CUT_API_TOKEN=" token}
    {print}
  ' .env > "${TEMP_ENV}"
  mv "${TEMP_ENV}" .env
  trap - EXIT
  echo "Created .env. Add OPENROUTER_API_KEY/GEMINI_API_KEY when those providers are used."
fi

mkdir -p projects data

# The container runs as uid 10001 (see Dockerfile). On Linux bind mounts keep
# host ownership, so hand the directories to that uid. Docker Desktop on macOS
# maps ownership itself, so leave it untouched there.
if [[ "$(uname -s)" == "Linux" ]]; then
  CONTAINER_UID=10001
  if [[ "$(stat -c '%u' projects)" != "${CONTAINER_UID}" || "$(stat -c '%u' data)" != "${CONTAINER_UID}" ]]; then
    if chown "${CONTAINER_UID}:${CONTAINER_UID}" projects data 2>/dev/null \
      || { command -v sudo >/dev/null 2>&1 && sudo -n chown "${CONTAINER_UID}:${CONTAINER_UID}" projects data 2>/dev/null; }; then
      echo "Set owner of ./projects and ./data to uid ${CONTAINER_UID}."
    else
      echo "WARNING: cannot chown ./projects and ./data to uid ${CONTAINER_UID}; the container may fail to write." >&2
      echo "         Run: sudo chown ${CONTAINER_UID}:${CONTAINER_UID} projects data" >&2
    fi
  fi
fi
docker compose config --quiet
docker compose build stage1-api
docker compose up -d stage1-api

for _attempt in $(seq 1 30); do
  if docker compose exec -T stage1-api curl -fsS http://localhost:8000/health >/dev/null 2>&1; then
    echo "Rough Cut is healthy. Open http://127.0.0.1:${ROUGH_CUT_PORT:-8000}/"
    exit 0
  fi
  sleep 2
done

docker compose logs --tail=100 stage1-api >&2
echo "Rough Cut did not become healthy within 60 seconds." >&2
exit 1
