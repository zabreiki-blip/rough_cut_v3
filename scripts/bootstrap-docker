#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  echo "Docker with Compose v2 is required." >&2
  exit 2
fi

if [[ ! -f .env ]]; then
  if ! command -v openssl >/dev/null 2>&1; then
    echo "OpenSSL is required to generate ROUGH_CUT_API_TOKEN." >&2
    exit 2
  fi
  cp .env.example .env
  GENERATED_TOKEN="$(openssl rand -hex 32)"
  TEMP_ENV="$(mktemp "${ROOT_DIR}/.env.XXXXXX")"
  trap 'rm -f "${TEMP_ENV}"' EXIT
  awk -v token="${GENERATED_TOKEN}" '
    /^ROUGH_CUT_API_TOKEN=/ {$0 = "ROUGH_CUT_API_TOKEN=" token}
    {print}
  ' .env > "${TEMP_ENV}"
  mv "${TEMP_ENV}" .env
  trap - EXIT
  echo "Created .env. Add OPENROUTER_API_KEY/GEMINI_API_KEY when those providers are used."
fi

mkdir -p projects data

# The image runs as uid 10001. Docker Desktop (macOS) translates bind-mount
# ownership, but on Linux the host owner must be able to hand write access to
# that uid. Only warn: this script never runs sudo.
if [[ "$(uname -s)" == "Linux" ]]; then
  for data_dir in projects data; do
    owner_uid="$(stat -c '%u' "${data_dir}" 2>/dev/null || true)"
    if [[ -n "${owner_uid}" && "${owner_uid}" != "10001" ]] \
      && ! getfacl -p "${data_dir}" 2>/dev/null | grep -q '^user:10001:rw'; then
      echo "WARNING: ${data_dir}/ is owned by uid ${owner_uid}, but the container runs as uid 10001." >&2
      echo "         The API cannot write there until you run one of (not executed automatically):" >&2
      echo "           sudo chown -R 10001:10001 projects data" >&2
      echo "           sudo setfacl -R -m u:10001:rwX -d -m u:10001:rwX projects data" >&2
      break
    fi
  done
fi
docker compose config --quiet
docker compose build stage1-api
docker compose up -d stage1-api

for _attempt in $(seq 1 30); do
  if docker compose exec -T stage1-api curl -fsS http://localhost:8000/health >/dev/null 2>&1; then
    echo "Rough Cut is healthy. Open http://127.0.0.1:${ROUGH_CUT_PORT:-8000}/"
    exit 0
  fi
  sleep 2
done

docker compose logs --tail=100 stage1-api >&2
echo "Rough Cut did not become healthy within 60 seconds." >&2
exit 1
