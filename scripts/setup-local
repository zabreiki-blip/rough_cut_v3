#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
VENV_DIR="${ROUGH_CUT_VENV:-${ROOT_DIR}/.venv}"

if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "Ошибка: нужен Python 3.11+." >&2
  exit 2
fi
if ! "${PYTHON_BIN}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  echo "Ошибка: нужен Python 3.11 или новее." >&2
  exit 2
fi

"${PYTHON_BIN}" -m venv "${VENV_DIR}"
"${VENV_DIR}/bin/python" -m pip install --upgrade pip
"${VENV_DIR}/bin/pip" install -r "${ROOT_DIR}/requirements-dev.txt"

if [[ ! -f "${ROOT_DIR}/.env" ]]; then
  cp "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
  if command -v openssl >/dev/null 2>&1; then
    GENERATED_TOKEN="$(openssl rand -hex 32)"
    TEMP_ENV="$(mktemp "${ROOT_DIR}/.env.XXXXXX")"
    trap 'rm -f "${TEMP_ENV}"' EXIT
    awk -v token="${GENERATED_TOKEN}" '
      /^ROUGH_CUT_API_TOKEN=/ {$0 = "ROUGH_CUT_API_TOKEN=" token}
      {print}
    ' "${ROOT_DIR}/.env" > "${TEMP_ENV}"
    mv "${TEMP_ENV}" "${ROOT_DIR}/.env"
    trap - EXIT
  fi
  echo "Создан .env. Добавьте ключ выбранного TTS/LLM-провайдера."
fi

mkdir -p "${ROOT_DIR}/projects" "${ROOT_DIR}/data"
"${ROOT_DIR}/scripts/doctor" --quick
echo "Готово. Запуск API: scripts/run-local"
