OPENROUTER_API_KEY=
ROUGH_CUT_API_TOKEN=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=openai/gpt-4o-audio-preview
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_TTS_VOICE_FEMALE=shimmer
OPENROUTER_TTS_VOICE_MALE=onyx
OPENROUTER_TTS_SAMPLE_RATE=24000

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_VOICE_FEMALE=Sharon
GEMINI_TTS_VOICE_MALE=Kore
TTS_PROVIDER=gemini
TTS_GENDER=female
# Bounded API concurrency; set to 1 for strict provider rate limits.
TTS_MAX_WORKERS=3
ANALYZER_LLM_WORKERS=4

MACOS_TTS_VOICE=Milena
MACOS_TTS_VOICE_FEMALE=Milena
MACOS_TTS_VOICE_MALE=Yuri
MACOS_TTS_RATE=175
MACOS_TTS_SAMPLE_RATE=24000
MACOS_CONNECTOR_URL=
MACOS_CONNECTOR_TOKEN=
MACOS_CONNECTOR_BIND=127.0.0.1

# Stage 2: local transcription of synchronized-sequence audio guides.
# Docker uses faster-whisper; Apple Silicon local runs may use mlx-whisper.
SYNC_WHISPER_BACKEND=auto
SYNC_WHISPER_MODEL=medium
SYNC_WHISPER_DEVICE=auto
SYNC_WHISPER_COMPUTE_TYPE=default
# Docker CPU defaults. Override only when the target runtime supports another device.
SYNC_WHISPER_DOCKER_DEVICE=cpu
SYNC_WHISPER_DOCKER_COMPUTE_TYPE=int8
# Optimized Docker CPU settings for an 8-vCPU / 8 GB VM.
SYNC_WHISPER_BEAM_SIZE=1
SYNC_WHISPER_BEST_OF=5
SYNC_WHISPER_BATCH_SIZE=4
SYNC_WHISPER_CPU_THREADS=8
# Hard deadline for one isolated transcription process (4 hours by default).
SYNC_WHISPER_TIMEOUT_SECONDS=14400
# Actual bytes read from a multipart WAV stream, not only Content-Length.
SYNC_AUDIO_MAX_BYTES=4294967296
# Review low-confidence blocks using only real Whisper candidate ranges.
SYNC_LLM_REVIEW_ENABLED=1
SYNC_LLM_REVIEW_THRESHOLD=0.80
SYNC_LLM_REVIEW_MAX_BLOCKS=30
# Allow authenticated requests from the local Premiere CEP file origin.
ROUGH_CUT_CEP_CORS=1
ROUGH_CUT_BIND=127.0.0.1
ROUGH_CUT_PORT=8000
MACOS_CONNECTOR_TIMEOUT=90
MACOS_COMMAND_TIMEOUT=900
FFMPEG_TIMEOUT_SECONDS=180

PROJECT_NAME=rough_cut_v3
MAX_ZK_BLOCKS=40
VALIDATE_MIN_WAV_DURATION_MS=350
VALIDATE_SILENCE_RMS_THRESHOLD=120
