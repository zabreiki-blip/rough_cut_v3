OPENROUTER_API_KEY=
ROUGH_CUT_API_TOKEN=
OPENROUTER_MODEL=openai/gpt-4o-mini
# The UI's "Быстро" mode uses OpenRouter provider routing by throughput.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional hard cap on completion tokens for every paid OpenRouter chat call
# (scenario analysis, normalization classifier, sync LLM review). Unset = derived
# per request from the input size (up to 16384). If an answer is cut off
# (finish_reason=length) the call fails without a retry; raise this value then.
# OPENROUTER_MAX_TOKENS=16384
# OpenRouter dedicated TTS endpoint. MAI-Voice-2 is expressive and intended
# for narration; its Azure voice names are model-specific.
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2
OPENROUTER_TTS_VOICE=ru-RU-Masha:MAI-Voice-2
OPENROUTER_TTS_VOICE_FEMALE=ru-RU-Masha:MAI-Voice-2
OPENROUTER_TTS_VOICE_MALE=ru-RU-Lev:MAI-Voice-2
OPENROUTER_TTS_SAMPLE_RATE=24000

# Voices for Gemini 3.1 Flash TTS through OpenRouter (no Google API key).
OPENROUTER_GEMINI_TTS_VOICE=Aoede
OPENROUTER_GEMINI_TTS_VOICE_FEMALE=Aoede
OPENROUTER_GEMINI_TTS_VOICE_MALE=Charon
TTS_PROVIDER=openrouter
TTS_GENDER=female
# Bounded API concurrency; set to 1 for strict provider rate limits.
TTS_MAX_WORKERS=3
ANALYZER_LLM_WORKERS=4

MACOS_TTS_VOICE=Milena
MACOS_TTS_VOICE_FEMALE=Milena
MACOS_TTS_VOICE_MALE=Yuri
MACOS_TTS_RATE=175
MACOS_TTS_SAMPLE_RATE=24000
MACOS_CONNECTOR_URL=
MACOS_CONNECTOR_TOKEN=
MACOS_CONNECTOR_BIND=127.0.0.1
MACOS_CONNECTOR_PORT=8001

# Stage 2: local transcription of synchronized-sequence audio guides.
# Docker uses faster-whisper; Apple Silicon local runs may use mlx-whisper.
SYNC_WHISPER_BACKEND=auto
SYNC_WHISPER_MODEL=medium
SYNC_WHISPER_DEVICE=auto
SYNC_WHISPER_COMPUTE_TYPE=default
# Docker CPU defaults. Override only when the target runtime supports another device.
SYNC_WHISPER_DOCKER_DEVICE=cpu
SYNC_WHISPER_DOCKER_COMPUTE_TYPE=int8
# Optimized Docker CPU settings for an 8-vCPU / 8 GB VM.
SYNC_WHISPER_BEAM_SIZE=1
SYNC_WHISPER_BEST_OF=5
SYNC_WHISPER_BATCH_SIZE=4
SYNC_WHISPER_CPU_THREADS=8
# Hard deadline for one isolated transcription process (4 hours by default).
SYNC_WHISPER_TIMEOUT_SECONDS=14400
# Set to 1 to release the Whisper model process after every successful job.
# This reduces idle RAM use at the cost of reloading the model for the next job.
SYNC_WHISPER_UNLOAD_AFTER_JOB=0
# Auto-unload the cached Whisper worker after it has sat idle this many
# seconds (default 900 = 15 min). Keeps long Premiere sessions from holding
# the loaded model in RAM forever without disabling the warm-start cache
# entirely. Set to 0 to disable and keep the worker alive indefinitely.
SYNC_WHISPER_IDLE_TIMEOUT_SECONDS=900
# Optional paid cloud ASR backend (single request per chunk transcribes and
# diarizes speech via an OpenRouter-compatible audio-input chat model, see
# src/stage2/cloud_asr.py). Never selected by SYNC_WHISPER_BACKEND=auto — set
# SYNC_WHISPER_BACKEND=cloud-audio explicitly to opt in.
# SYNC_WHISPER_BACKEND=cloud-audio
# Dedicated key for this backend; falls back to OPENROUTER_API_KEY if unset.
SYNC_CLOUD_ASR_API_KEY=
# Shared audio between adjacent cloud-ASR chunks, in seconds.
SYNC_CLOUD_ASR_OVERLAP_SEC=60
# Completion-token cap per cloud-ASR request (default 32768).
# SYNC_CLOUD_ASR_MAX_TOKENS=32768
# Actual bytes read from a multipart WAV stream, not only Content-Length.
SYNC_AUDIO_MAX_BYTES=4294967296
# Flask request-body ceiling. It is automatically raised above the audio
# limit by multipart headroom, so a valid maximum-size WAV remains uploadable.
# ROUGH_CUT_MAX_REQUEST_BODY_BYTES=4311744512
# Review low-confidence blocks using only real Whisper candidate ranges.
SYNC_LLM_REVIEW_ENABLED=1
SYNC_LLM_REVIEW_THRESHOLD=0.80
SYNC_LLM_REVIEW_MAX_BLOCKS=30
# Matcher gate: a match with a gap between neighbouring words, or a single word
# lasting, longer than this many seconds is never auto-matched (needs_review,
# flag large_time_gap). Invalid, zero, negative or non-finite values -> 5.
# SYNC_MATCH_MAX_INTERNAL_GAP_SEC=5
# Offset-cluster pass: strong global-fallback matches (fallback_full, confident, not
# ambiguous, no flags) are auto-matched when >= MIN_SUPPORT OTHER such matches of the same
# source share a found_in - approx timecode offset (single linkage, LINK_SEC apart): a
# systematic timecode shift of a stretch of the file. Set ENABLED=0 to turn it off
# (previously promoted matches then return to needs_review). Confirmed/manual matches
# count as supporters. MAX_WIDTH_SEC: a supporting cluster wider than this is not one
# shift (no promotion). MIN_WORDS: shorter quotes (matcher normalization) neither get
# promoted nor support others. Bad values -> defaults.
# SYNC_OFFSET_CLUSTER_ENABLED=1
# SYNC_OFFSET_CLUSTER_LINK_SEC=60
# SYNC_OFFSET_CLUSTER_MIN_SUPPORT=3
# SYNC_OFFSET_CLUSTER_MAX_WIDTH_SEC=240
# SYNC_OFFSET_CLUSTER_MIN_WORDS=5
# Allow authenticated requests from the local Premiere CEP file origin.
ROUGH_CUT_CEP_CORS=1
ROUGH_CUT_BIND=127.0.0.1
ROUGH_CUT_PORT=8000
# Docker resource ceiling (docker-compose.yml). Whisper medium int8 on CPU needs
# about 2-3 GB; defaults leave headroom for ffmpeg and audio buffers.
# ROUGH_CUT_MEM_LIMIT=8g
# ROUGH_CUT_CPUS: 0 = без лимита. Иначе не больше числа CPU, доступных Docker
# (Docker Desktop: Settings > Resources), иначе контейнер не стартует.
# SYNC_WHISPER_CPU_THREADS (default 8) — отдельная настройка.
# ROUGH_CUT_CPUS=0
# Maximum simultaneous ASR transcriptions across all projects (sync + final
# review, local or cloud). Default 1; invalid or < 1 values fall back to 1.
# Extra jobs wait in the queue ("Waiting for an ASR slot") and can be cancelled.
# ROUGH_CUT_MAX_ASR_JOBS=1
# Optional host-side projects root used when container paths are returned to CEP.
ROUGH_CUT_HOST_PROJECTS_ROOT=
MACOS_CONNECTOR_TIMEOUT=90
MACOS_COMMAND_TIMEOUT=900
# Bound JSON requests accepted by the host-side macOS connector (default 256 KiB).
# MACOS_CONNECTOR_MAX_REQUEST_BODY_BYTES=262144
FFMPEG_TIMEOUT_SECONDS=180

# Default project name written to the stage1 manifest when the CLI validates
# without an explicit project (src/stage1/validator.py).
PROJECT_NAME=rough_cut_v3
MAX_ZK_BLOCKS=40
VALIDATE_MIN_WAV_DURATION_MS=350
VALIDATE_SILENCE_RMS_THRESHOLD=120

# Final review hard deadline in seconds (default 7200).
FINAL_REVIEW_TIMEOUT_SECONDS=7200
# Maximum estimated cloud ASR cost per job in USD; 0 disables enforcement.
ROUGH_CUT_MAX_USD_PER_JOB=0
# Estimated cloud ASR cost per audio minute in USD; 0 means unknown.
ROUGH_CUT_CLOUD_ASR_USD_PER_MINUTE_ESTIMATE=0
# Estimated LLM cost per 1000 tokens in USD (prompt chars/4 + max_tokens per attempt);
# 0 means the estimate is unknown: nothing is reserved before sending, but actual
# costs (usage.cost) are still counted, and paid calls are blocked once
# ROUGH_CUT_MAX_USD_PER_JOB is already exceeded (in a sync job this only disables LLM review).
ROUGH_CUT_LLM_USD_PER_1K_TOKENS_ESTIMATE=0
# Estimated TTS cost per 1000 input characters in USD; 0 means the estimate is unknown
# (nothing is reserved before sending; paid calls are still blocked once
# ROUGH_CUT_MAX_USD_PER_JOB is already exceeded).
ROUGH_CUT_TTS_USD_PER_1K_CHARS_ESTIMATE=0
